    <DTS:Executable
      DTS:refId="Package\SQL_Crear_Vendedor_Sin_Asignar"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{992E7390-A4BE-4869-A177-D47ACE3488C9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Crear_Vendedor_Sin_Asignar"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2B744C1B-51EB-4EB6-B848-E77EA3166E9A}"
          SQLTask:SqlStatementSource="&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.DimEmpleado&#xA;    WHERE EmpleadoID = -1&#xA;)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dbo.DimEmpleado ON;&#xA;&#xA;    INSERT INTO dbo.DimEmpleado (&#xA;        VendedorKey,&#xA;        EmpleadoID,&#xA;        Cargo,&#xA;        Genero,&#xA;        EstadoCivil&#xA;    )&#xA;    VALUES (&#xA;        -1,&#xA;        -1,&#xA;        'Sin vendedor asignado',&#xA;        NULL,&#xA;        NULL&#xA;    );&#xA;&#xA;    SET IDENTITY_INSERT dbo.DimEmpleado OFF;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Limpiar_DW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
