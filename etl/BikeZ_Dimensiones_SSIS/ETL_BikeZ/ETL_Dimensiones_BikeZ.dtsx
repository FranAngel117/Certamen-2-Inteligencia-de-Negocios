      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2B744C1B-51EB-4EB6-B848-E77EA3166E9A}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.FactVentas;&#xA;DELETE FROM dbo.DimProducto;&#xA;DELETE FROM dbo.DimCliente;&#xA;DELETE FROM dbo.DimEmpleado;&#xA;DELETE FROM dbo.DimTerritorio;&#xA;DELETE FROM dbo.DimTiempo;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
